    "version" : "1.0"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "security" : [ {
    "bearer" : [ ]
  } ],
  "tags" : [ {
    "description" : "Stored scenarios and their results",
    "name" : "Scenarios"
  }, {
    "description" : "Solve scenarios: maximum profit and the numbers of fluts to buy",
    "name" : "Evaluations"
  } ],
  "paths" : {
    "/api/evaluations" : {
      "post" : {
        "description" : "Send the scenarios either as a JSON body (normalized format) or as an uploaded file (multipart part `file`): `.txt` in the original format of the specification, or `.json` in the normalized format. Send `Accept: text/plain` to get the original output format.",
        "operationId" : "evaluateFile",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "example" : "{\n  \"scenarios\": [\n    { \"name\": \"Example 1\", \"schuurs\": [ { \"boxPrices\": [12, 3, 10, 7, 16, 5] } ] },\n    { \"name\": \"Example 2\", \"schuurs\": [\n        { \"boxPrices\": [7, 3, 11, 9, 10] },\n        { \"boxPrices\": [1, 2, 3, 4, 10, 16, 10, 4, 16] } ] }\n  ]\n}",
              "schema" : {
                "$ref" : "#/components/schemas/ScenariosInput"
              }
            },
            "multipart/form-data" : {
              "schema" : {
                "type" : "object",
                "properties" : {
                  "file" : {
                    "type" : "string",
                    "format" : "binary",
                    "description" : "A .txt or .json file"
                  }
                },
                "required" : [ "file" ]
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EvaluationResponse"
                }
              },
              "text/plain" : {
                "example" : "schuurs 1\nMaximum profit is 8.\nNumber of fluts to buy: 4\n\nschuurs 2\nMaximum profit is 40.\nNumber of fluts to buy: 6 7 8 9 10 12 13\n",
                "schema" : {
                  "type" : "string"
                }
              }
            },
            "description" : "Results in input order"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "example" : {
                  "type" : "about:blank",
                  "title" : "Invalid input",
                  "status" : 400,
                  "detail" : "Schuur declares 3 boxes but lists 2 prices",
                  "line" : 2
                },
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Invalid input (with the line number for text input)"
          },
          "403" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Forbidden"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Not Found"
          },
          "413" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Input larger than the configured limit"
          }
        },
        "summary" : "Evaluate scenarios",
        "tags" : [ "Evaluations" ]
      }
    },
